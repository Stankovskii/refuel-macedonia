{
  "name": "ReFuel Macedonia",
  "short_name": "ReFuel",
  "description": "Fuel. Where you are. — fuel delivery, live prices, stations, routes and fleet contracts for North Macedonia.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [ "window-controls-overlay", "standalone", "minimal-ui" ],
  "orientation": "any",
  "background_color": "#0B0D12",
  "theme_color": "#0B0D12",
  "lang": "mk",
  "dir": "ltr",
  "categories": [ "business", "productivity", "utilities" ],
  "icons": [
    { "src": "/img/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/img/favicon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "/img/favicon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/img/refuel-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/refuel-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Order fuel",
      "short_name": "Order",
      "url": "/Orders/Create",
      "icons": [ { "src": "/img/favicon-192.png", "sizes": "192x192" } ]
    },
    {
      "name": "Prices",
      "short_name": "Prices",
      "url": "/Prices",
      "icons": [ { "src": "/img/favicon-192.png", "sizes": "192x192" } ]
    },
    {
      "name": "Dispatch board",
      "short_name": "Dispatch",
      "url": "/Dispatch",
      "icons": [ { "src": "/img/favicon-192.png", "sizes": "192x192" } ]
    }
  ]
}
