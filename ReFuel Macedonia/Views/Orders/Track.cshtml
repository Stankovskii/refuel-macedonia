@model TrackingVm
@{
    ViewData["Title"] = T["order.track"] + " " + Model.Order.Reference;
    var order = Model.Order;
    var driver = Model.Driver;
}

<div class="container">
    <a class="back-link" asp-action="Details" asp-route-id="@order.Id">
        <partial name="_Icons" model="@("arrow-left")" /> @T["common.back"]
    </a>

    <section class="track-hero section">
        <div class="spread" style="align-items:flex-start">
            <div>
                <span class="badge badge-onway" id="status-badge">
                    <span class="dot pulse" style="background:currentColor"></span> <span id="status-text">@T[Fmt.StatusKey(order.Status)]</span>
                </span>
                <h1 style="margin-top:.6rem">@T["order.track.heading"]</h1>
                <p class="mono" style="opacity:.8;margin:0">@order.Reference · @Fmt.Litres(order.Litres) @order.FuelType?.ShortName</p>
            </div>
            <div class="right">
                <div class="eta-big"><span id="eta-min">@Fmt.Plain(Model.RemainingMinutes, 0)</span></div>
                <div class="eta-unit">@T["home.active.minutes"]</div>
                <div class="small" style="opacity:.75;margin-top:.3rem"><span id="eta-km">@Fmt.Km(Model.RemainingKm)</span></div>
            </div>
        </div>

        <div class="progress-rail"><span id="progress-bar" style="width:@Model.ProgressPercent%"></span></div>

        <ul class="steps">
            @foreach (var step in Model.Steps)
            {
                <li class="@(step.Done ? "done" : "") @(step.Active ? "active" : "")">
                    <div class="bar"></div>
                    <span>@T[Fmt.StatusKey(step.Status)]</span>
                </li>
            }
        </ul>
    </section>

    <div class="split">
        <div class="stack">
            <div class="card" style="padding:0;overflow:hidden">
                <div id="map-track" class="map-box map-md" style="border:0;border-radius:0"></div>
            </div>

            <div class="card">
                <h2>@T["order.timeline"]</h2>
                <ul class="timeline">
                    @foreach (var entry in order.StatusHistory.OrderBy(h => h.CreatedAtUtc))
                    {
                        <li>
                            <span class="time">@Fmt.LocalTime(entry.CreatedAtUtc)</span>
                            <strong>@T[Fmt.StatusKey(entry.Status)]</strong>
                            @if (!string.IsNullOrEmpty(entry.Note))
                            {
                                <span class="muted small">· @T[entry.Note]</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="stack">
            @if (driver is not null)
            {
                <div class="card card-accent">
                    <span class="eyebrow"><partial name="_Icons" model="@("user")" /> @T["track.driver.title"]</span>
                    <div class="driver-card" style="margin-top:.5rem">
                        <img class="driver-photo driver-photo-lg" src="@driver.DriverPhotoUrl" alt="@driver.DriverName" />
                        <div class="driver-meta">
                            <strong>@driver.DriverName</strong>
                            <div class="rating-stars">★★★★★ <span class="soft">@Fmt.N(driver.DriverRating, 1)</span></div>
                            <span class="small soft">@driver.CompletedDeliveries @T["track.driver.deliveries"] · @driver.YearsOfExperience @T["track.driver.years"]</span>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <table class="data" style="font-size:.84rem">
                        <tbody>
                        <tr><td>@T["track.driver.truck"]</td><td class="num mono">@driver.TruckModel</td></tr>
                        <tr><td>@T["track.driver.plate"]</td><td class="num mono">@driver.PlateNumber</td></tr>
                        <tr><td>@T["track.driver.capacity"]</td><td class="num">@Fmt.Litres(driver.CapacityLitres)</td></tr>
                        <tr><td>@T["track.driver.base"]</td><td class="num">@driver.BaseCity</td></tr>
                        </tbody>
                    </table>

                    <div class="flex" style="margin-top:.8rem">
                        <a class="btn btn-primary btn-sm btn-block" href="tel:@driver.Phone">
                            <partial name="_Icons" model="@("phone")" /> @driver.Phone
                        </a>
                    </div>

                    @if (driver.HasHazmatLicence)
                    {
                        <div class="chips" style="margin-top:.6rem">
                            <span class="chip chip-brand">ADR</span>
                            @if (driver.CanServeBoats) { <span class="chip">@T["asset.boat"]</span> }
                            @if (driver.CanServeConstruction) { <span class="chip">@T["asset.constructionmachine"]</span> }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card">
                    <h3>@T["track.driver.title"]</h3>
                    <p class="small soft">@T["track.driver.pending"]</p>
                </div>
            }

            <div class="card">
                <h3>@T["order.delivery"]</h3>
                <p class="small soft" style="margin:0">
                    <strong>@order.DeliveryAddress</strong><br />
                    @order.DeliveryCity<br />
                    @order.ContactPhone
                </p>
                <div class="divider"></div>
                <table class="data" style="font-size:.84rem">
                    <tbody>
                    <tr><td>@T["station.fuel"]</td><td class="num">@order.FuelType?.LocalizedName(T.Culture)</td></tr>
                    <tr><td>@T["order.litres"]</td><td class="num">@Fmt.Litres(order.Litres)</td></tr>
                    <tr><td>@T["order.total"]</td><td class="num"><strong>@Fmt.Money(order.Total, 0)</strong></td></tr>
                    <tr><td>@T["order.payment"]</td><td class="num">@T["order.pay." + order.PaymentMethod.ToString().ToLowerInvariant()]</td></tr>
                    </tbody>
                </table>
            </div>

            @if (order.Station is not null)
            {
                <div class="card">
                    <h3>@T["order.sourcedfrom"]</h3>
                    <strong><a asp-controller="Stations" asp-action="Details" asp-route-id="@order.Station.Id">@order.Station.Name</a></strong>
                    <div class="muted small">@order.Station.City · @order.Station.Brand?.Name</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var origin = [@Json.Serialize(Model.OriginLat), @Json.Serialize(Model.OriginLng)];
            var dest = [@Json.Serialize(Model.DestinationLat), @Json.Serialize(Model.DestinationLng)];
            var current = [@Json.Serialize(Model.CurrentLat), @Json.Serialize(Model.CurrentLng)];
            var orderId = @order.Id;

            var map = L.map("map-track", { zoomControl: true }).setView(current, 13);
            ReFuel.tileLayer().addTo(map);

            L.circleMarker(origin, { radius: 7, color: "#0E9E77", fillColor: "#0E9E77", fillOpacity: .9 })
                .addTo(map).bindPopup(@Json.Serialize(order.Station?.Name ?? "ReFuel"));

            L.marker(dest).addTo(map).bindPopup(@Json.Serialize(order.DeliveryAddress));

            L.polyline([origin, dest], { color: "#0E9E77", weight: 3, opacity: .45, dashArray: "8,8" }).addTo(map);

            var truckIcon = L.divIcon({
                className: "refuel-truck",
                html: '<div style="background:#FF7A1A;color:#fff;border:3px solid #fff;border-radius:50%;width:36px;height:36px;' +
                      'display:grid;place-items:center;box-shadow:0 6px 16px rgba(0,0,0,.35);font-size:16px">&#128667;</div>',
                iconSize: [36, 36], iconAnchor: [18, 18]
            });

            var truck = L.marker(current, { icon: truckIcon, zIndexOffset: 500 }).addTo(map);
            map.fitBounds(L.latLngBounds([origin, dest, current]).pad(0.28));

            function refresh() {
                fetch("/Orders/Live/" + orderId, { headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) return;
                        truck.setLatLng([data.currentLat, data.currentLng]);
                        document.getElementById("progress-bar").style.width = data.progress + "%";
                        document.getElementById("eta-min").textContent = Math.round(data.remainingMinutes);
                        document.getElementById("eta-km").textContent = data.remainingKm.toFixed(1) + " km";
                    })
                    .catch(function () { });
            }

            setInterval(refresh, 20000);
        })();
    </script>
}
