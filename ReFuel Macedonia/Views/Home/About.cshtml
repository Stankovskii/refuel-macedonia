@{
    ViewData["Title"] = T["about.title"];
}
<div class="container">
    <h1>@T["about.title"]</h1>
    <p class="muted">@T["about.intro"]</p>

    <div class="grid grid-3 section">
        <div class="card">
            <h3>@T["about.f1.title"]</h3>
            <p class="small soft">@T["about.f1.body"]</p>
        </div>
        <div class="card">
            <h3>@T["about.f2.title"]</h3>
            <p class="small soft">@T["about.f2.body"]</p>
        </div>
        <div class="card">
            <h3>@T["about.f3.title"]</h3>
            <p class="small soft">@T["about.f3.body"]</p>
        </div>
        <div class="card">
            <h3>@T["about.f4.title"]</h3>
            <p class="small soft">@T["about.f4.body"]</p>
        </div>
        <div class="card">
            <h3>@T["about.f5.title"]</h3>
            <p class="small soft">@T["about.f5.body"]</p>
        </div>
        <div class="card">
            <h3>@T["about.f6.title"]</h3>
            <p class="small soft">@T["about.f6.body"]</p>
        </div>
    </div>

    <div class="card">
        <h2>@T["about.data.title"]</h2>
        <ul class="small soft">
            <li>@T["footer.source.erc"]</li>
            <li>@T["footer.source.osm"]</li>
            <li>@T["footer.source.users"]</li>
        </ul>
        <p class="small muted">@T["about.data.note"]</p>
    </div>
</div>
