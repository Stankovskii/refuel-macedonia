@{
    ViewData["Title"] = T["b2b.title"];
}

<div class="container">
    <section class="hero">
        <div class="hero-grid">
            <div>
                <span class="hero-badge"><partial name="_Icons" model="@("building")" /> ReFuel Business</span>
                <h1>@T["b2b.hero.title"]</h1>
                <p class="lead">@T["b2b.hero.subtitle"]</p>
                <div class="hero-actions">
                    <a class="btn btn-accent btn-lg" asp-controller="Business" asp-action="Index">@T["b2b.cta.portal"]</a>
                    <a class="btn btn-ghost btn-lg" asp-controller="Account" asp-action="Register">@T["b2b.cta.contact"]</a>
                </div>
                <div class="hero-trust">
                    <div><strong>12</strong><span>@T["b2b.trust.months"]</span></div>
                    <div><strong>22:00 – 05:00</strong><span>@T["b2b.trust.window"]</span></div>
                    <div><strong>ADR</strong><span>@T["b2b.trust.adr"]</span></div>
                    <div><strong>@T["b2b.trust.digital"]</strong><span>POD + e-Invoice</span></div>
                </div>
            </div>

            <div class="order-widget">
                <h3><partial name="_Icons" model="@("invoice")" /> @T["b2b.calc.title"]</h3>
                <p class="small muted" style="margin:0">@T["b2b.calc.subtitle"]</p>
                <div class="fields">
                    <div>
                        <label>@T["b2b.calc.litres"]</label>
                        <input type="number" id="b2b-litres" value="90000" min="1000" step="1000" />
                    </div>
                    <div>
                        <label>@T["b2b.calc.discount"]</label>
                        <input type="number" id="b2b-discount" value="3.5" min="0" max="10" step="0.1" />
                    </div>
                </div>
                <div class="widget-summary">
                    <div>
                        <div class="tiny upper" style="margin:0">@T["b2b.calc.monthly"]</div>
                        <strong id="b2b-monthly">315.000 ден</strong>
                    </div>
                    <div class="right">
                        <div class="tiny upper" style="margin:0">@T["b2b.calc.yearly"]</div>
                        <strong id="b2b-yearly">3.780.000 ден</strong>
                    </div>
                </div>
                <p class="tiny muted" style="margin-top:.6rem">@T["b2b.calc.note"]</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("truck")" /> @T["b2b.who.eyebrow"]</span>
                <h2>@T["b2b.who.title"]</h2>
            </div>
        </div>
        <div class="grid grid-4">
            <div class="card card-hover">
                <div class="feature-icon"><partial name="_Icons" model="@("truck")" /></div>
                <h3>@T["asset.truck"]</h3>
                <p class="small soft">@T["b2b.who.trucks"]</p>
            </div>
            <div class="card card-hover">
                <div class="feature-icon sky"><partial name="_Icons" model="@("boat")" /></div>
                <h3>@T["asset.boat"]</h3>
                <p class="small soft">@T["b2b.who.boats"]</p>
            </div>
            <div class="card card-hover">
                <div class="feature-icon orange"><partial name="_Icons" model="@("excavator")" /></div>
                <h3>@T["asset.constructionmachine"]</h3>
                <p class="small soft">@T["b2b.who.construction"]</p>
            </div>
            <div class="card card-hover">
                <div class="feature-icon violet"><partial name="_Icons" model="@("bus")" /></div>
                <h3>@T["asset.bus"]</h3>
                <p class="small soft">@T["b2b.who.buses"]</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("shield")" /> @T["b2b.how.eyebrow"]</span>
                <h2>@T["b2b.how.title"]</h2>
            </div>
        </div>
        <div class="grid grid-3">
            <div class="card">
                <div class="feature-icon"><partial name="_Icons" model="@("invoice")" /></div>
                <h3>1. @T["b2b.how.s1.title"]</h3>
                <p class="small soft">@T["b2b.how.s1.body"]</p>
            </div>
            <div class="card">
                <div class="feature-icon sky"><partial name="_Icons" model="@("clock")" /></div>
                <h3>2. @T["b2b.how.s2.title"]</h3>
                <p class="small soft">@T["b2b.how.s2.body"]</p>
            </div>
            <div class="card">
                <div class="feature-icon violet"><partial name="_Icons" model="@("shield")" /></div>
                <h3>3. @T["b2b.how.s3.title"]</h3>
                <p class="small soft">@T["b2b.how.s3.body"]</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="card card-dark" style="padding:2rem">
            <div class="split" style="align-items:center">
                <div>
                    <h2>@T["b2b.proof.title"]</h2>
                    <p class="muted">@T["b2b.proof.body"]</p>
                    <ul class="small" style="color:#C9D5E6;line-height:2">
                        <li>@T["b2b.proof.p1"]</li>
                        <li>@T["b2b.proof.p2"]</li>
                        <li>@T["b2b.proof.p3"]</li>
                        <li>@T["b2b.proof.p4"]</li>
                    </ul>
                </div>
                <div class="card" style="background:#fff">
                    <div class="spread">
                        <strong class="mono">POD-2026-000148</strong>
                        <span class="badge badge-ok">@T["proof.verified"]</span>
                    </div>
                    <div class="divider"></div>
                    <table class="data" style="font-size:.82rem">
                        <tbody>
                        <tr><td>@T["proof.litres"]</td><td class="num"><strong>640,0 л</strong></td></tr>
                        <tr><td>@T["proof.meterstart"]</td><td class="num mono">128.402,0</td></tr>
                        <tr><td>@T["proof.meterend"]</td><td class="num mono">129.042,0</td></tr>
                        <tr><td>@T["proof.driver"]</td><td class="num">Александар С.</td></tr>
                        </tbody>
                    </table>
                    <div class="hash-box" style="margin-top:.5rem">A93F1C7B20E4D5A8C6F0B2E71D4A9083</div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var litres = document.getElementById("b2b-litres");
            var discount = document.getElementById("b2b-discount");
            var monthly = document.getElementById("b2b-monthly");
            var yearly = document.getElementById("b2b-yearly");

            function fmt(v) {
                return Math.round(v).toLocaleString("de-DE") + " ден";
            }

            function calc() {
                var l = parseFloat(litres.value) || 0;
                var d = parseFloat(discount.value) || 0;
                monthly.textContent = fmt(l * d);
                yearly.textContent = fmt(l * d * 12);
            }

            litres.addEventListener("input", calc);
            discount.addEventListener("input", calc);
            calc();
        })();
    </script>
}
