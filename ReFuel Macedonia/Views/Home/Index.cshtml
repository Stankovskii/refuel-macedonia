@model HomeVm
@{
    ViewData["Title"] = T["home.title"];
    var mainFuelId = Model.Board.FirstOrDefault(b => b.Code == "EUROSUPER_95")?.FuelTypeId
                     ?? Model.Board.FirstOrDefault()?.FuelTypeId ?? 0;
    var individual = Model.Segments.FirstOrDefault(s => s.Key == "individual");
    var business = Model.Segments.FirstOrDefault(s => s.Key == "business");
    var fleet = Model.Segments.FirstOrDefault(s => s.Key == "fleet");
    var minFee = Fmt.Money(Model.MinDeliveryFee, 0);

    string DiscountLabel(HomeSegmentVm s) =>
        s.DiscountTo <= 0m ? T["home.seg.pump"]
        : s.DiscountFrom <= 0m ? T.Format("home.seg.upto", Fmt.N(s.DiscountTo, 2))
        : s.DiscountFrom == s.DiscountTo ? T.Format("home.seg.fixed", Fmt.N(s.DiscountTo, 2))
        : T.Format("home.seg.range", Fmt.N(s.DiscountFrom, 2), Fmt.N(s.DiscountTo, 2));
}

<div class="container">

    <section class="hero">
        <div class="hero-grid">
            <div>
                <span class="hero-badge"><partial name="_Icons" model="@("truck")" /> @T["home.hero.badge"]</span>
                <h1>@T["home.hero.title"]</h1>
                <p class="lead">@T["home.hero.subtitle"]</p>

                <div class="hero-actions">
                    <a class="btn btn-accent btn-lg" asp-controller="Orders" asp-action="Create">
                        <partial name="_Icons" model="@("fuel")" /> @T["home.cta.order"]
                    </a>
                    <a class="btn btn-ghost btn-lg" asp-controller="Orders" asp-action="Create" asp-route-type="@OrderType.Emergency">
                        <partial name="_Icons" model="@("alert")" /> @T["home.cta.sos"]
                    </a>
                    <a class="btn btn-ghost btn-lg" asp-controller="Home" asp-action="Business">
                        <partial name="_Icons" model="@("building")" /> @T["home.cta.business"]
                    </a>
                </div>

                <div class="hero-trust">
                    <div><strong>@Fmt.Plain(Model.AverageDeliveryMinutes, 0) min</strong><span>@T["home.trust.avgtime"]</span></div>
                    <div><strong>@Fmt.N(Model.DeliveriesCompleted)</strong><span>@T["home.trust.deliveries"]</span></div>
                    <div><strong>@Model.TankerCount</strong><span>@T["home.stats.tankers"]</span></div>
                    <div><strong>@Model.StationCount</strong><span>@T["home.stat.stations"]</span></div>
                </div>
            </div>

            <div class="order-widget">
                <h3><partial name="_Icons" model="@("fuel")" /> @T["home.widget.title"]</h3>
                <p class="small muted" style="margin:0">@T["home.widget.subtitle"]</p>

                <form asp-controller="Orders" asp-action="Create" method="get" asp-antiforgery="false">
                    <div class="fields">
                        <div>
                            <label for="quick-fuel">@T["station.fuel"]</label>
                            <select name="fuelTypeId" id="quick-fuel">
                                @foreach (var fuel in Model.QuickOrder.Fuels)
                                {
                                    <option value="@fuel.Id" selected="@(fuel.Id == Model.QuickOrder.FuelTypeId)">@fuel.LocalizedName(T.Culture)</option>
                                }
                            </select>
                        </div>
                        <div class="row-2">
                            <div>
                                <label for="quick-litres">@T["order.litres"]</label>
                                <input type="number" name="litres" id="quick-litres" min="10" max="120" step="5" value="@Fmt.Plain(Model.QuickOrder.Litres, 0)" />
                            </div>
                            <div>
                                <label for="quick-type">@T["order.type"]</label>
                                <select name="type" id="quick-type">
                                    <option value="@((int)OrderType.Standard)">@T["order.type.standard"]</option>
                                    <option value="@((int)OrderType.Scheduled)">@T["order.type.scheduled"]</option>
                                    <option value="@((int)OrderType.Emergency)">@T["order.type.emergency"]</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="widget-summary">
                        <div>
                            <div class="tiny upper" style="margin:0">@T["home.widget.estimate"]</div>
                            <strong>@Fmt.Money(Model.QuickOrder.EstimatedTotal, 0)</strong>
                        </div>
                        <div class="right">
                            <div class="tiny upper" style="margin:0">@T["order.eta"]</div>
                            <strong>~@Fmt.Plain(Model.QuickOrder.EtaMinutes, 0) min</strong>
                        </div>
                    </div>
                    <p class="tiny muted" style="margin:.45rem 0 0">@T["home.widget.note"]</p>

                    <button class="btn btn-primary btn-block btn-lg" type="submit" style="margin-top:.9rem">
                        @T["home.widget.cta"] <partial name="_Icons" model="@("arrow-right")" />
                    </button>
                </form>

                @if (Model.Drivers.Count > 0)
                {
                    <div class="driver-strip">
                        <span class="stack-avatars">
                            @foreach (var driver in Model.Drivers.Take(5))
                            {
                                <img src="@driver.DriverPhotoUrl" alt="@driver.DriverName" title="@driver.DriverName" />
                            }
                        </span>
                        <span class="small muted">@T.Format("home.widget.drivers", Model.Drivers.Count)</span>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (Model.Board.Count > 0)
    {
        <div class="ticker" aria-label="@T["home.board.subtitle"]">
            <div class="ticker-label"><span class="dot"></span> @T["home.ticker.label"]</div>
            <div class="ticker-items">
                @foreach (var fuel in Model.Board)
                {
                    <a class="ticker-item" asp-controller="Prices" asp-action="Index" title="@fuel.Name">
                        <span class="name">@fuel.Name</span>
                        <span class="val">@Fmt.N(fuel.Price, 2)</span>
                        <span class="unit">@(fuel.Unit == "kg" ? T["unit.perkg"] : T["unit.perl"])</span>
                        <span class="trend @Fmt.TrendClass(fuel.Trend)">@Fmt.TrendArrow(fuel.Trend) @Fmt.Change(fuel.Change)</span>
                    </a>
                }
            </div>
            <div class="ticker-meta">
                @if (Model.PriceEffectiveFrom.HasValue)
                {
                    @T.Format("home.ticker.validfrom", Fmt.LocalTime(Model.PriceEffectiveFrom.Value, "dd.MM.yyyy"))
                }
                @if (!string.IsNullOrWhiteSpace(Model.PriceDecisionReference))
                {
                    <text> · @T.Format("home.ticker.decision", Model.PriceDecisionReference)</text>
                }
            </div>
        </div>
    }

    <div class="creds">
        <div class="cred">
            <div class="ico-wrap"><partial name="_Icons" model="@("scale")" /></div>
            <div><strong>@T["home.cred.erc.title"]</strong><span>@T["home.cred.erc.body"]</span></div>
        </div>
        <div class="cred">
            <div class="ico-wrap"><partial name="_Icons" model="@("shield")" /></div>
            <div><strong>@T["home.cred.adr.title"]</strong><span>@T["home.cred.adr.body"]</span></div>
        </div>
        <div class="cred">
            <div class="ico-wrap"><partial name="_Icons" model="@("gauge")" /></div>
            <div><strong>@T["home.cred.meter.title"]</strong><span>@T["home.cred.meter.body"]</span></div>
        </div>
        <div class="cred">
            <div class="ico-wrap"><partial name="_Icons" model="@("qr")" /></div>
            <div><strong>@T["home.cred.qr.title"]</strong><span>@T["home.cred.qr.body"]</span></div>
        </div>
    </div>

    @if (Model.ActiveTracking is not null && Model.ActiveOrder is not null)
    {
        var tracking = Model.ActiveTracking;
        <section class="section">
            <div class="card card-dark" style="padding:1.4rem">
                <div class="spread" style="align-items:flex-start">
                    <div>
                        <span class="badge badge-onway"><span class="dot pulse" style="background:currentColor"></span> @T["home.active.title"]</span>
                        <h2 style="margin-top:.5rem">@T[Fmt.StatusKey(Model.ActiveOrder.Status)]</h2>
                        <p class="muted small mono">@Model.ActiveOrder.Reference · @Fmt.Litres(Model.ActiveOrder.Litres) @Model.ActiveOrder.FuelType?.ShortName</p>
                    </div>
                    <div class="right">
                        <div class="eta-big">@Fmt.Plain(tracking.RemainingMinutes, 0)</div>
                        <div class="eta-unit">@T["home.active.minutes"]</div>
                    </div>
                </div>

                <div class="progress-rail"><span style="width:@tracking.ProgressPercent%"></span></div>

                <div class="spread">
                    @if (tracking.Driver is not null)
                    {
                        <div class="driver-card">
                            <img class="driver-photo" src="@tracking.Driver.DriverPhotoUrl" alt="@tracking.Driver.DriverName" />
                            <div class="driver-meta">
                                <strong>@tracking.Driver.DriverName</strong>
                                <span class="rating-stars">★ @Fmt.N(tracking.Driver.DriverRating, 1)</span>
                                <span> · @tracking.Driver.TruckModel · @tracking.Driver.PlateNumber</span>
                            </div>
                        </div>
                    }
                    <a class="btn btn-accent" asp-controller="Orders" asp-action="Track" asp-route-id="@Model.ActiveOrder.Id">
                        <partial name="_Icons" model="@("pin")" /> @T["order.track"]
                    </a>
                </div>
            </div>
        </section>
    }

    @if (Model.Segments.Count > 0)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <span class="eyebrow"><partial name="_Icons" model="@("tag")" /> @T["home.seg.eyebrow"]</span>
                    <h2>@T["home.seg.title"]</h2>
                    <p class="muted small">@T["home.seg.subtitle"]</p>
                </div>
                <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Business">@T["home.cta.business"]</a>
            </div>

            <div class="segments">
                @if (individual is not null)
                {
                    <div class="segment">
                        <div class="segment-head"><h3>@T["home.seg.individual"]</h3><div class="ico-wrap"><partial name="_Icons" model="@("user")" /></div></div>
                        <div class="segment-price">
                            <span class="pump">@DiscountLabel(individual)</span>
                            <small>@T.Format("home.seg.individual.sub", Fmt.Money(individual.MinDeliveryFee, 0), individual.ScheduledDiscountPercent, Fmt.Money(individual.EmergencySurcharge, 0))</small>
                        </div>
                        <ul>
                            <li><partial name="_Icons" model="@("check")" /> @T.Format("home.seg.individual.b1", Fmt.Plain(individual.MinLitres, 0), Fmt.Plain(individual.MaxLitres, 0))</li>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.individual.b2"]</li>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.individual.b3"]</li>
                        </ul>
                        <a class="btn btn-ghost" asp-controller="Orders" asp-action="Create">@T["home.seg.individual.cta"]</a>
                    </div>
                }
                @if (business is not null)
                {
                    <div class="segment @(business.Featured ? "featured" : "")" data-flag="@T["home.seg.flag"]">
                        <div class="segment-head"><h3>@T["home.seg.business"]</h3><div class="ico-wrap"><partial name="_Icons" model="@("excavator")" /></div></div>
                        <div class="segment-price">
                            <span class="pump">@DiscountLabel(business)</span>
                            <small>@T.Format("home.seg.business.sub", Fmt.Money(business.MinDeliveryFee, 0))</small>
                        </div>
                        <ul>
                            <li><partial name="_Icons" model="@("check")" /> @T.Format("home.seg.business.b1", Fmt.Plain(business.MinLitres, 0), Fmt.Plain(business.MaxLitres, 0))</li>
                            <li><partial name="_Icons" model="@("check")" /> @(business.HasVolumeBands ? T["home.seg.business.b2"] : T["home.seg.business.b2.flat"])</li>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.business.b3"]</li>
                        </ul>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">@T["b2b.cta.contact"]</a>
                    </div>
                }
                @if (fleet is not null)
                {
                    <div class="segment">
                        <div class="segment-head"><h3>@T["home.seg.fleet"]</h3><div class="ico-wrap"><partial name="_Icons" model="@("bus")" /></div></div>
                        <div class="segment-price">
                            <span class="pump">@DiscountLabel(fleet)</span>
                            <small>@T["home.seg.fleet.sub"]</small>
                        </div>
                        <ul>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.fleet.b1"]</li>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.fleet.b2"]</li>
                            <li><partial name="_Icons" model="@("check")" /> @T["home.seg.fleet.b3"]</li>
                        </ul>
                        <a class="btn btn-ghost" asp-controller="Home" asp-action="Business">@T["home.seg.fleet.cta"]</a>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("sparkle")" /> @T["home.how.eyebrow"]</span>
                <h2>@T["home.how.title"]</h2>
            </div>
        </div>

        <div class="steps-row">
            <div class="step"><div class="num">1</div><h3>@T["home.how.s1.title"]</h3><p>@T["home.how.s1.body"]</p></div>
            <div class="step"><div class="num">2</div><h3>@T["home.how.s2.title"]</h3><p>@T["home.how.s2.body"]</p></div>
            <div class="step"><div class="num">3</div><h3>@T["home.how.s3.title"]</h3><p>@T["home.how.s3.body"]</p></div>
            <div class="step"><div class="num">4</div><h3>@T["home.how.s4.title"]</h3><p>@T["home.how.s4.body"]</p></div>
        </div>
    </section>

    <section class="section">
        <div class="stats-band">
            <div>
                <h2>@T["home.stats.title"]</h2>
                <p class="lead">@T["home.stats.lead"]</p>
            </div>
            <div class="stat"><strong>@Fmt.N(Model.LitresDelivered, 0)</strong><span>@T["home.stats.litres"]</span></div>
            <div class="stat"><strong>@Fmt.N(Model.DeliveriesCompleted)</strong><span>@T["home.stats.deliveries"]</span></div>
            <div class="stat"><strong>@Model.BusinessContracts</strong><span>@T["home.stats.contracts"]</span></div>
            <div class="stat"><strong>@Model.TankerCount / @Model.DeliveryCityCount</strong><span>@T["home.stats.fleet"]</span></div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("chart")" /> @T["home.board.subtitle"]</span>
                <h2>@T["home.board.title"]</h2>
                <p class="muted small">@T["prices.updated"] @Fmt.LocalTime(Model.LastPriceUpdateUtc)</p>
            </div>
            <a class="btn btn-ghost btn-sm" asp-controller="Prices" asp-action="Index">@T["common.details"]</a>
        </div>

        <div class="price-board">
            @foreach (var fuel in Model.Board)
            {
                <div class="price-tile" style="--tile-color:@fuel.Color">
                    <div class="fuel-name">@fuel.Name</div>
                    <div class="price-value">
                        @Fmt.N(fuel.Price, 2)
                        <span class="price-unit">@(fuel.Unit == "kg" ? T["unit.perkg"] : T["unit.perl"])</span>
                    </div>
                    <div class="@Fmt.TrendClass(fuel.Trend) trend">
                        @Fmt.TrendArrow(fuel.Trend) @Fmt.Change(fuel.Change)
                        <span class="muted tiny">(@Fmt.N(fuel.ChangePercent, 2) %)</span>
                    </div>

                    @if (fuel.StationCount > 0)
                    {
                        <div class="market-row">
                            <span>@T["price.min"] <strong>@Fmt.N(fuel.MarketMin, 2)</strong></span>
                            <span>@T["price.avg"] <strong>@Fmt.N(fuel.MarketAvg, 2)</strong></span>
                        </div>
                    }

                    @if (fuel.PredictedNext > 0)
                    {
                        <div class="price-meta">
                            @T["home.board.forecast"]: <strong>@Fmt.N(fuel.PredictedNext, 2)</strong>
                            <span class="@Fmt.TrendClass(fuel.PredictedTrend)">@Fmt.TrendArrow(fuel.PredictedTrend)</span>
                        </div>
                    }
                    else
                    {
                        <div class="price-meta">@T["price.effective"] @Fmt.LocalTime(fuel.EffectiveFrom, "dd.MM.yyyy")</div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="split section">
        <div class="card">
            <div class="spread">
                <h2>@T["home.chart.title"]</h2>
                <a class="small" asp-controller="Prices" asp-action="Index">@T["common.more"]</a>
            </div>
            <p class="muted small">@T["home.chart.subtitle"]</p>
            <div class="chart-box"><canvas id="chart-history"></canvas></div>
        </div>

        <div class="card">
            <h2>@T["home.cheapest.title"]</h2>
            <p class="muted small">@T["home.cheapest.subtitle"]</p>

            @if (Model.Cheapest.Count == 0)
            {
                <p class="muted">@T["common.nodata"]</p>
            }
            else
            {
                foreach (var station in Model.Cheapest)
                {
                    <div class="station-row">
                        <span class="station-dot" style="background:@station.BrandColor"></span>
                        <div class="station-main">
                            <strong><a asp-controller="Stations" asp-action="Details" asp-route-id="@station.Id">@station.Name</a></strong>
                            <span>@station.City @(station.Brand is null ? "" : "· " + station.Brand)</span>
                        </div>
                        <div class="station-price">@(station.Price.HasValue ? Fmt.N(station.Price.Value, 2) : "-")</div>
                    </div>
                }
            }
        </div>
    </section>

    @if (Model.Recommendation is not null && Model.Recommendation.Items.Count > 0)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <span class="eyebrow"><partial name="_Icons" model="@("sparkle")" /> AI</span>
                    <h2>@T["home.reco.title"]</h2>
                    <p class="muted small">@T["ai.reco.explained"]</p>
                </div>
                <a class="btn btn-ghost btn-sm" asp-controller="Analytics" asp-action="Index">@T["nav.ai"]</a>
            </div>

            <div class="grid grid-4">
                @foreach (var item in Model.Recommendation.Items)
                {
                    <div class="card card-tight card-hover reco-card">
                        <strong><a asp-controller="Stations" asp-action="Details" asp-route-id="@item.Station.Id">@item.Station.Name</a></strong>
                        <div class="muted small">@item.Station.City · @Fmt.Km(item.DistanceKm)</div>
                        <div class="station-price">@Fmt.N(item.Price, 2)</div>
                        <div class="score-bar"><span style="width:@Fmt.N(item.Score * 100, 0)%"></span></div>
                        <div class="chips" style="margin-top:.45rem">
                            @foreach (var reason in item.Reasons.Take(3))
                            {
                                <span class="reason">@T[reason]</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.Promotions.Count > 0)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <span class="eyebrow"><partial name="_Icons" model="@("tag")" /> @T["home.promo.subtitle"]</span>
                    <h2>@T["home.promo.title"]</h2>
                </div>
                <a class="btn btn-ghost btn-sm" asp-controller="Promotions" asp-action="Index">@T["common.all"]</a>
            </div>

            <div class="grid grid-4">
                @foreach (var promo in Model.Promotions)
                {
                    var promoValue = promo.DiscountType switch
                    {
                        DiscountType.Percentage => "-" + Fmt.N(promo.Value, 0) + " %",
                        DiscountType.PerLitre => "-" + Fmt.N(promo.Value, 0) + " " + T["unit.perl.short"],
                        DiscountType.FreeDelivery => T["promo.freedelivery"],
                        _ => "-" + Fmt.N(promo.Value, 0) + " " + T["unit.mkd"]
                    };

                    <div class="card card-tight card-hover promo-card" style="--promo-color:@promo.ColorHex">
                        <div class="promo-value">@promoValue</div>
                        <strong>@promo.Title(T.Culture)</strong>
                        <p class="muted small">@promo.Description(T.Culture)</p>
                        <span class="badge chip-brand mono">@promo.Code</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("map")" /> @T["home.coverage.eyebrow"]</span>
                <h2>@T["home.coverage.title"]</h2>
                <p class="muted small">@T["home.coverage.subtitle"]</p>
            </div>
            <a class="btn btn-ghost btn-sm" asp-controller="Stations" asp-action="Map">@T["home.cta.map"]</a>
        </div>
        <div class="coverage">
            <div id="coverage-map" class="map-box map-md"></div>
            <div class="zone-list">
                @if (Model.Zones.Count == 0)
                {
                    <div class="empty-state">
                        <partial name="_Icons" model="@("map")" />
                        <strong>@T["common.nodata"]</strong>
                    </div>
                }
                @foreach (var zone in Model.Zones)
                {
                    <div class="zone-row">
                        <span class="swatch" style="background:@zone.ColorHex"></span>
                        <div>
                            <strong>@zone.Name</strong>
                            <span>@string.Join(", ", zone.CityList.Take(5))</span>
                        </div>
                        <span class="fee">@T.Format("home.coverage.from", Fmt.Money(zone.BaseDeliveryFee, 0))</span>
                    </div>
                }
                <p class="tiny muted" style="margin:.2rem 0 0">@T["home.map.subtitle"]</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <span class="eyebrow"><partial name="_Icons" model="@("shield")" /> @T["home.faq.eyebrow"]</span>
                <h2>@T["home.faq.title"]</h2>
            </div>
        </div>
        <div class="faq">
            <details open>
                <summary>@T["home.faq.q1"]</summary>
                <p>@T["home.faq.a1"]</p>
            </details>
            <details>
                <summary>@T["home.faq.q2"]</summary>
                <p>@T.Format("home.faq.a2", minFee, Model.ScheduledDiscountPercent)</p>
            </details>
            <details>
                <summary>@T["home.faq.q3"]</summary>
                <p>@T["home.faq.a3"]</p>
            </details>
            <details>
                <summary>@T["home.faq.q4"]</summary>
                <p>@T["home.faq.a4"]</p>
            </details>
            <details>
                <summary>@T["home.faq.q5"]</summary>
                <p>@T["home.faq.a5"]</p>
            </details>
            <details>
                <summary>@T["home.faq.q6"]</summary>
                <p>@T["home.faq.a6"]</p>
            </details>
        </div>
    </section>

    <section class="section">
        <div class="cta-band">
            <div>
                <h2>@T["home.ctaband.title"]</h2>
                <p>@T.Format("home.ctaband.body", minFee)</p>
            </div>
            <div class="flex">
                <a class="btn btn-dark btn-lg" asp-controller="Orders" asp-action="Create"><partial name="_Icons" model="@("fuel")" /> @T["home.cta.order"]</a>
                <a class="btn btn-ghost btn-lg" asp-controller="Account" asp-action="Register"><partial name="_Icons" model="@("building")" /> @T["b2b.cta.contact"]</a>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var series = @Html.Raw(Json.Serialize(Model.Series.Select(s => new {
                label = s.Name,
                color = s.Color,
                points = s.Points.Select(p => new { date = p.Date.ToString("dd.MM.yy"), price = p.Price })
            })));

            ReFuel.lineChart("chart-history", series);

            var map = ReFuel.createStationMap("coverage-map", { zoom: 8 });
            ReFuel.loadStations(map, "/api/v1/stations/map?fuelTypeId=@mainFuelId");

            var zones = @Html.Raw(Json.Serialize(Model.Zones.Select(z => new {
                name = z.Name,
                lat = z.CenterLatitude,
                lng = z.CenterLongitude,
                radiusKm = z.RadiusKm,
                color = z.ColorHex
            })));
            ReFuel.drawZones(map, zones);
        })();
    </script>
}
