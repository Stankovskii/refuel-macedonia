@{
    ViewData["Title"] = T["error.title"];
}
<div class="container">
    <div class="card" style="max-width:640px;margin:2rem auto;text-align:center">
        <h1>@T["error.title"]</h1>
        <p class="muted">@T["error.body"]</p>
        @if (ViewBag.RequestId is string requestId && !string.IsNullOrEmpty(requestId))
        {
            <p class="small muted mono">Request ID: @requestId</p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@T["error.home"]</a>
    </div>
</div>
